# Copy this file to ".env" and fill in your Firebase Web app config
# (Firebase console -> Project settings -> Your apps -> Web app -> SDK setup).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Automatic SMS backend (optional) — NOT set here. These live in the Netlify
# dashboard (Site configuration -> Environment variables), because they are
# server-only secrets for netlify/functions/send-sms.js. See README.md.
#
#   SMS_PROVIDER=smsgate           # or: httpsms | twilio
#   FIREBASE_API_KEY=<same as VITE_FIREBASE_API_KEY>
#   SMS_ALLOWED_EMAILS=owner@example.com
#   SMSGATE_USERNAME= / SMSGATE_PASSWORD=          # sms-gate.app cloud creds
#   HTTPSMS_API_KEY= / HTTPSMS_FROM=+213661234567
#   TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM=
# ---------------------------------------------------------------------------
